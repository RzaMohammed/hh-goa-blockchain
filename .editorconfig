# EditorConfig helps maintain consistent coding styles across editors
root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{js,jsx,json,css,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.sol]
indent_size = 4

[Makefile]
indent_style = tab
