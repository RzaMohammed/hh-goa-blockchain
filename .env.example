# =====================================================================
# Face Identification & Blockchain Verification - Environment Variables
# =====================================================================

# Ethereum Sepolia RPC URL
# Examples:
# - Infura: https://sepolia.infura.io/v3/YOUR_INFURA_PROJECT_ID
# - Alchemy: https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
# - Public Node: https://ethereum-sepolia-rpc.publicnode.com
# - Public Node: https://rpc.sepolia.org
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Ethereum Sepolia Wallet Private Key (MUST NEVER be shared or committed!)
# Used to sign transactions for contract deployment and hash registration.
# Ensure your address has Sepolia test ETH (from faucets like https://cloud.google.com/application/web3/faucet/ethereum/sepolia)
PRIVATE_KEY=0x_your_private_key_here

# Deployed Smart Contract Address on Sepolia
# Generated after running `python blockchain/deploy.py`
CONTRACT_ADDRESS=0x_your_deployed_contract_address_here

# Reverse Image Search API Keys (Choose at least one)
# -------------------------------------------------------------
# 1. SerpApi (Google Lens engine) - https://serpapi.com (Free tier: 100-250 searches/month)
SERPAPI_API_KEY=your_serpapi_key_here

# 2. Serper.dev (Google Lens engine) - https://serper.dev (Free tier: 2,500 queries)
SERPER_API_KEY=your_serper_key_here

# 3. SearchApi.io (Google Lens engine) - https://www.searchapi.io (Free tier available)
SEARCHAPI_API_KEY=your_searchapi_key_here

# Default Search Provider (serpapi, serper, searchapi, or direct)
DEFAULT_SEARCH_PROVIDER=serpapi

# Matching & Verification Parameters
SIMILARITY_THRESHOLD=0.60
OUTPUT_DIR=output
