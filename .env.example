# =====================================================================
# Face Identification & Blockchain Verification - Environment Variables
# =====================================================================

# Local Ethereum-Compatible Blockchain (Ganache) RPC URL
# Typical endpoints:
# - Ganache UI default: http://127.0.0.1:7545
# - Ganache CLI default: http://127.0.0.1:8545
LOCAL_RPC_URL=http://127.0.0.1:7545

# Local Ganache Wallet Private Key
# Copy any private key from Ganache's pre-funded development accounts.
# In Ganache UI: Click the key icon next to an account to view its private key.
# In Ganache CLI: Look under "Private Keys" printed at startup.
LOCAL_PRIVATE_KEY=your_ganache_private_key_here

# Deployed Smart Contract Address on Local Blockchain
# Generated automatically after running `python blockchain/deploy.py`
CONTRACT_ADDRESS=your_deployed_contract_address_here

# Reverse Image Search API Keys (Optional, for Google Lens reverse search)
# -------------------------------------------------------------
# 1. SerpApi (Google Lens engine) - https://serpapi.com (Free tier available)
SERPAPI_API_KEY=your_serpapi_key_here

# 2. Serper.dev (Google Lens engine) - https://serper.dev (Free tier available)
SERPER_API_KEY=your_serper_key_here

# 3. SearchApi.io (Google Lens engine) - https://www.searchapi.io
SEARCHAPI_API_KEY=your_searchapi_key_here

# Default Search Provider (serpapi, serper, searchapi, or direct)
DEFAULT_SEARCH_PROVIDER=direct

# Matching & Verification Parameters
SIMILARITY_THRESHOLD=0.55
OUTPUT_DIR=output

# Server & API Configuration
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=1
LOG_LEVEL=INFO

# Frontend Client Configuration
VITE_PORT=5173
VITE_API_BASE_URL=http://localhost:5000

# Biometric Model Weights (Auto-downloaded if not present)
YUNET_MODEL_PATH=models/face_detection_yunet_2023mar.onnx
SFACE_MODEL_PATH=models/face_recognition_sface_2021dec.onnx

